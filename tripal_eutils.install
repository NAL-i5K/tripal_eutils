<?php

use Drupal\tripal_chado\Services\ChadoCustomTable;

/**
 * @file
 * Install, update and uninstall functions for the Tripal Eutils module.
 */

/**
 * Implements hook_install().
 */
function tripal_eutils_install() {

  $buddy_service = \Drupal::service('tripal_chado.chado_buddy');
  /** @var Drupal\tripal_chado\Plugin\ChadoBuddy\ChadoDbxrefBuddy **/
  $dbxref_instance = $buddy_service->createInstance('chado_dbxref_buddy', []);
  //** #var Drupal\tripal_chado\Plugin\ChadoBuddy\ChadoCvtermBuddy **/
  $cvterm_instance = $buddy_service->createInstance('chado_cvterm_buddy', []);
  $custom_table_service = \Drupal::service('tripal_chado.custom_tables');

  $cvterm_instance->upsertCv([
    'cv.name' => 'NCBI BioSample Attributes',
    'cv.definition' => 'The ncbi BioSample Attributes CV is downloaded from https://www.ncbi.nlm.nih.gov/biosample/docs/attributes/?format=xml',
  ], []);

  $cvterm_instance->upsertCvterm([
    'db.name' => 'local',
    'dbxref.accession' => 'full_ncbi_xml',
    'cv.name' => 'local',
    'cvterm.name' => 'full_ncbi_xml',
  ], []);

  $cvterm_instance->upsertCvterm([
    'db.name' => 'local',
    'dbxref.accession' => 'ncbi_FTP_links',
    'cv.name' => 'local',
    'cvterm.name' => 'NCBI Data Download FTP Link',
  ], []);
  tripal_eutils_add_dbs($dbxref_instance);
  tripal_eutils_insert_biosample_attribute_terms($cvterm_instance);
  tripal_eutils_install_chado_1_4_tables($custom_table_service);
  tripal_eutils_insert_extra_biosample_terms($cvterm_instance);
  tripal_eutils_create_dbs_for_assembly_xrefs($dbxref_instance);
}

/**
 * Implements hook_uninstall().
 */
function tripal_eutils_uninstall() {
  // Should not be needed because this table is defined by hook_schema, but here we are.
  db_drop_table('chado.tripal_eutils_tag_dictionary');

}

/**
 * Extra biosample property terms discovered in @ticket 170.
 *
 * @param $cvterm_instance
 *   CVterm buddy service instance
 */
function tripal_eutils_insert_extra_biosample_terms($cvterm_instance): void {

  $cvterm_instance->upsertCvterm([
    'db.name' => 'NCBI_BioSample_Attributes',
    'dbxref.accession' => 'samples provided by',
    'cv.name' => 'NCBI BioSample Attributes',
    'cvterm.name' => 'Samples provided by',
    'cvterm.definition' => '',
  ], []);

  $cvterm_instance->upsertCvterm([
    'db.name' => 'NCBI_BioSample_Attributes',
    'dbxref.accession' => 'Publication',
    'cv.name' => 'NCBI BioSample Attributes',
    'cvterm.name' => 'Publication',
    'cvterm.definition' => '',
  ], []);

  $cvterm_instance->upsertCvterm([
    'db.name' => 'NCBI_BioSample_Attributes',
    'dbxref.accession' => 'note',
    'cv.name' => 'NCBI BioSample Attributes',
    'cvterm.name' => 'Note',
    'cvterm.definition' => 'Misc. free text.',
  ], []);
}

/**
 * Updates the NCBI BioSample Attribute CV Terms
 *
 * Automatically downloads and imports into the CVterm table the attribute
 * names for biomaterials.
 *
 * @param $cvterm_instance
 *   CVterm buddy service instance
 */
function tripal_eutils_insert_biosample_attribute_terms($cvterm_instance) {
  // We use NCBI biosample attributes to fill the 'NCBI BioSample Attributes' CV.
  // These attributes can be accessed at the following url:
  // https://www.ncbi.nlm.nih.gov/biosample/docs/attributes/?format=xml
  $lookup = new \BiosamplePropertyLookup();
  $terms = $lookup->lookupAll();

  foreach ($terms as $machine_name => $attributes) {
    $cvterm_instance->upsertCvterm([
      'db.name' => 'NCBI_BioSample_Attributes',
      'dbxref.accession' => $machine_name,
      'cv.name' => 'NCBI BioSample Attributes',
      'cvterm.name' => $attributes['label'],
      'cvterm.definition' => $attributes['def'],
    ], []);
  }
}

/**
 * Implements hook_schema()
 */
function tripal_eutils_schema() {

  // This table is not currently used.  It would allow admins to use custom cvterms when loading in properties.  However, for now we want to limit this.
  $schema['tripal_eutils_tag_dictionary'] = [
    'table' => 'tripal_eutils_tag_dictionary',
    'description' => 'Stores all attribute tags encountered and their mappings',
    'fields' => [
      'id' => [
        'type' => 'serial',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'tag' => [
        'type' => 'varchar',
        'length' => 255,
        'not null' => TRUE,
        'description' => 'The XML tag name.',
      ],
      'type' => [
        'description' => 'NCBI database type.',
        'type' => 'varchar',
        'length' => 60,
        'not null' => TRUE,
      ],
      'status' => [
        'description' => 'assigned, unassigned, ignored',
        'type' => 'varchar',
        'length' => 60,
        'not null' => TRUE,
      ],

      'cvterm_id' => [
        'description' => 'The cvterm this tag is mapped to.',
        'type' => 'int',
        'not null' => FALSE,
      ],
    ],
    'primary key' => [
      'id',
    ],
  ];
  return $schema;
}

/**
 * Custom tables. These are not deleted on uninstall since they
 * are chado 1.4 tables.
 *
 */
function tripal_eutils_chado_1_4_schema() {

  // Linker table between biomaterials and projects.
  $schema['biomaterial_project'] = [
    'table' => 'biomaterial_project',
    'fields' => [
      'biomaterial_project_id' => ['type' => 'serial', 'not null' => TRUE],
      'biomaterial_id' => ['type' => 'int', 'not null' => TRUE],
      'project_id' => ['type' => 'int', 'not null' => TRUE],
    ],
    'primary key' => ['biomaterial_project_id'],
    'foreign keys' => [
      'biomaterial' => [
        'table' => 'biomaterial',
        'columns' => [
          'biomaterial_id' => 'biomaterial_id',
        ],
      ],
      'project' => [
        'table' => 'project',
        'columns' => [
          'project_id' => 'project_id',
        ],
      ],
    ],
    'indexes' => [
      'biomaterial_project_idx1' => ['biomaterial_id'],
      'biomaterial_project_idx2' => ['project_id'],
    ],
    'unique keys' => [
      'biomaterial_project_unique_uq1' => ['biomaterial_id', 'project_id'],
    ],
  ];

  // Linker table between organisms and analyses.
  // This table schema is identical to the tripal_manage_analyses module schema.
  $schema['organism_analysis'] = [
    'table' => 'organism_analysis',
    'fields' => [
      'organism_analysis_id' => ['type' => 'serial', 'not null' => TRUE],
      'organism_id' => ['type' => 'int', 'not null' => TRUE],
      'analysis_id' => ['type' => 'int', 'not null' => TRUE],
    ],
    'primary key' => ['organism_analysis_id'],
    'foreign keys' => [
      'organism' => [
        'table' => 'organism',
        'columns' => [
          'organism_id' => 'organism_id',
        ],
      ],
      'analysis' => [
        'table' => 'analysis',
        'columns' => [
          'analysis_id' => 'analysis_id',
        ],
      ],
    ],
    'indexes' => [
      'organism_analysis_idx1' => ['organism_id'],
      'organism_analysis_idx2' => ['analysis_id'],

    ],
    'unique keys' => [
      'organism_analysis_unique_uq1' => ['organism_id', 'analysis_id'],
    ],
  ];

  return $schema;

}

/**
 * Add chado db records.
 *
 * @param $dbxref_instance
 *   Dbxref buddy service instance
 */
function tripal_eutils_add_dbs($dbxref_instance) {
  $dbxref_instance->upsertDb([
    'db.name' => 'NCBI BioSample',
    'db.description' => 'The BioSample database contains descriptions of biological source materials used in experimental assays.',
    'db.urlprefix' => 'http://www.ncbi.nlm.nih.gov/biosample/{accession}',
    'db.url' => 'https://www.ncbi.nlm.nih.gov/biosample/',
  ], []);

  $dbxref_instance->upsertDb([
    'db.name' => 'NCBI SRA',
    'db.description' => '',
    'db.urlprefix' => 'https://www.ncbi.nlm.nih.gov/sra/{accession}',
    'db.url' => 'https://www.ncbi.nlm.nih.gov/sra/',
  ], []);

  $dbxref_instance->upsertDb([
    'db.name' => 'NCBI_BioSample_Attributes',
    'db.description' => 'This database provides, in XML format, the listing of attribute names for biosamples housed in NCBI.',
    'db.urlprefix' => '',
    'db.url' => 'https://www.ncbi.nlm.nih.gov/biosample/docs/attributes',
  ], []);

  $dbxref_instance->upsertDb([
    'db.name' => 'NCBI WGS',
    'db.description' => '',
    'db.urlprefix' => 'https://www.ncbi.nlm.nih.gov/Traces/wgs/{accession}',
    'db.url' => 'https://www.ncbi.nlm.nih.gov/Traces/wgs/',
  ], []);

  $dbxref_instance->upsertDb([
    'db.name' => 'NCBI Refseq',
    'db.description' => 'A comprehensive, integrated, non-redundant, well-annotated set of reference sequences including genomic, transcript, and protein.',
    'db.urlprefix' => 'https://www.ncbi.nlm.nih.gov/refseq/{accession}',
    'db.url' => 'https://www.ncbi.nlm.nih.gov/refseq/',
  ], []);

  $dbxref_instance->upsertDb([
    'db.name' => 'NCBI GenBank',
    'db.description' => 'GenBank ® is the NIH genetic sequence database, an annotated collection of all publicly available DNA sequences (Nucleic Acids Research, 2013 Jan;41(D1):D36-42).',
    'db.urlprefix' => 'https://www.ncbi.nlm.nih.gov/genbank/{accession}',
    'db.url' => 'https://www.ncbi.nlm.nih.gov/genbank/',
  ], []);

  $dbxref_instance->upsertDb([
    'db.name' => 'NCBI BioProject',
    'db.description' => "A BioProject is a collection of biological data related to a single initiative, originating from a single organization or from a consortium.",
    'db.urlprefix' => 'https://www.ncbi.nlm.nih.gov/bioproject/{accession}',
    'db.url' => 'https://www.ncbi.nlm.nih.gov/bioproject/',
  ], []);

  $dbxref_instance->upsertDb([
    'db.name' => 'NCBI Assembly',
    'db.description' => "A database providing information on the structure of assembled genomes, assembly names and other meta-data, statistical reports, and links to genomic sequence data..",
    'db.urlprefix' => 'https://www.ncbi.nlm.nih.gov/assembly/{accession}',
    'db.url' => 'https://www.ncbi.nlm.nih.gov/assembly/',
  ], []);

  tripal_eutils_create_dbs_for_assembly_xrefs($dbxref_instance);

}

/**
 * Adds Chado linker tables that this module needs.
 *
 * These tables will be in the Chado 1.4 release so let's add them here for now.
 *
 * @param $custom_table_service
 *   The chado custom table service
 */
function tripal_eutils_install_chado_1_4_tables($custom_table_service) {
  // A list of the tables to be added
  $tables = ['biomaterial_project', 'organism_analysis'];

  $existing_schema = \Drupal::service('tripal_chado.database')->schema();
  $new_schema = tripal_eutils_chado_1_4_schema();

  foreach ($tables as $table) {
    if (!$existing_schema->tableExists($table)) {
      $new_table = $custom_table_service->create($table);
      $new_table->setTableSchema($new_schema[$table]);
    }
  }
}

/**
 * Creates db entries for keys introduced in the assembly loader.
 *
 * @param $dbxref_instance
 *   DB buddy service instance
 */
function tripal_eutils_create_dbs_for_assembly_xrefs($dbxref_instance) {

  $dbxref_instance->upsertDb([
    'db.name' => 'Refseq Assembly',
    'db.description' => "A database providing information on the structure of assembled genomes, assembly names and other meta-data, statistical reports, and links to genomic sequence data..",
    'db.urlprefix' => 'https://www.ncbi.nlm.nih.gov/assembly/{accession}',
    'db.url' => 'https://www.ncbi.nlm.nih.gov/assembly/',
  ], []);

  $dbxref_instance->upsertDb([
    'db.name' => 'Genbank Assembly',
    'db.description' => "A database providing information on the structure of assembled genomes, assembly names and other meta-data, statistical reports, and links to genomic sequence data..",
    'db.urlprefix' => 'https://www.ncbi.nlm.nih.gov/assembly/{accession}',
    'db.url' => 'https://www.ncbi.nlm.nih.gov/assembly/',
  ], []);
}
